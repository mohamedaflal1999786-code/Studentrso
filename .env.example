# ==============================================================================
# Student RSO 2.0 — Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# DO NOT commit .env.local to Git.

# --- Supabase Configuration (Required for Auth, Profiles & RLS) ---
# Obtain from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Site URL Configuration ---
# Used for OAuth callbacks and email redirect URLs
# Local development: http://localhost:3000
# Production: https://studentrso.in
NEXT_PUBLIC_SITE_URL=https://studentrso.in
NEXT_PUBLIC_APP_URL=https://studentrso.in

# --- Authentication & Session Signing (Optional / Fallback) ---
# Random 32+ character string for token signing
JWT_SECRET=your_jwt_secret_min_32_characters_here

# --- Cron Security (Optional) ---
# Secret bearer token to secure automated sync & maintenance routes
CRON_SECRET=your_cron_secret_token_here

# --- AI Career Assistant Integrations (Optional) ---
# Groq: Free API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini: Free API key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# --- Email Notifications (Optional - Supabase Auth handles transactional OTPs natively) ---
# Resend API Key for custom notifications if enabled
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM="Student RSO <support@studentrso.in>"
